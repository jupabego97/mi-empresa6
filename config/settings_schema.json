      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 280,
        "step": 10,
        "unit": "px",
        "label": "Ancho del logo",
        "default": 160
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Eslogan",
        "default": "Tecnología que impulsa tu rendimiento"
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
