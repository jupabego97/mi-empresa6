      },
      {
        "type": "color",
        "id": "color_royal",
        "label": "Azul royal",
        "default": "#1E3A8A"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Fondo oscuro",
        "default": "#0F172A"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Acento CTA",
        "default": "#0066FF"
      }
    ]
  },
  {
    "name": "WhatsApp",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
