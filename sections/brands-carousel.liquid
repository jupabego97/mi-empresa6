<section class="nt-section">
  <div class="nt-container">
    <div class="nt-section-header nt-section-header--center">
      <h2 class="nt-heading" style="font-size:1.5rem">{% render 'i18n-or-setting', value: section.settings.title, locale_key: 'sections.brands_title' %}</h2>
    </div>
    <div class="nt-brands">
      {% for block in section.blocks %}
        <span class="nt-brands__item" {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Marcas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Marcas que confiamos" }
  ],
  "blocks": [
    { "type": "brand", "name": "Marca", "settings": [
      { "type": "text", "id": "name", "label": "Nombre", "default": "Marca" }
    ]}
  ],
  "presets": [{
    "name": "Marcas",
    "blocks": [
      { "type": "brand", "settings": { "name": "Logitech" }},
      { "type": "brand", "settings": { "name": "HP" }},
      { "type": "brand", "settings": { "name": "Lenovo" }},
      { "type": "brand", "settings": { "name": "Samsung" }},
      { "type": "brand", "settings": { "name": "Xiaomi" }},
      { "type": "brand", "settings": { "name": "JBL" }},
      { "type": "brand", "settings": { "name": "ASUS" }},
      { "type": "brand", "settings": { "name": "MSI" }},
      { "type": "brand", "settings": { "name": "Sony" }}
    ]
  }]
}
{% endschema %}
