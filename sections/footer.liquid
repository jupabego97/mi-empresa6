<footer class="nt-footer">
  <div class="nt-container">
    <div class="nt-footer__grid">
      <div>
        <a href="{{ routes.root_url }}" class="nt-header__logo" style="color:white;margin-bottom:1rem;display:inline-block">
          NANO<span style="color:var(--nt-electric)">TRONICS</span>
        </a>
        <p style="font-size:0.875rem;line-height:1.7;max-width:320px">
          {{ 'footer.tagline' | t }}
        </p>
        <p style="margin-top:1rem;font-size:0.875rem">
          📍 {{ settings.store_address }}<br>
          📞 {{ settings.store_phone }}<br>
          ✉️ {{ settings.store_email }}
        </p>
      </div>
      <div>
        <h3 class="nt-footer__title">{{ 'footer.shop' | t }}</h3>
        <a href="{{ routes.collections_url }}" class="nt-footer__link">{{ 'general.categories' | t }}</a>
        <a href="{{ routes.collections_url }}/ofertas" class="nt-footer__link">{{ 'general.offers' | t }}</a>
        <a href="/pages/marcas" class="nt-footer__link">{{ 'general.brands' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="nt-footer__link">{{ 'footer.all_products' | t }}</a>
      </div>
      <div>
        <h3 class="nt-footer__title">{{ 'footer.company' | t }}</h3>
        <a href="/pages/nosotros" class="nt-footer__link">{{ 'footer.about' | t }}</a>
        <a href="/pages/servicio-tecnico" class="nt-footer__link">{{ 'general.technical_service' | t }}</a>
        <a href="/pages/contacto" class="nt-footer__link">{{ 'footer.contact' | t }}</a>
        <a href="/policies/shipping-policy" class="nt-footer__link">{{ 'footer.shipping_policy' | t }}</a>
        <a href="/policies/refund-policy" class="nt-footer__link">{{ 'footer.warranty_policy' | t }}</a>
      </div>
      <div>
        <h3 class="nt-footer__title">{{ 'footer.help' | t }}</h3>
        <a href="https://wa.me/{{ settings.whatsapp_number }}" class="nt-footer__link" target="_blank">{{ 'general.whatsapp' | t }}</a>
        <a href="/pages/contacto" class="nt-footer__link">{{ 'general.support' | t }}</a>
        <a href="/pages/preguntas-frecuentes" class="nt-footer__link">{{ 'footer.faq_link' | t }}</a>
        {% if settings.social_instagram != blank %}
          <a href="{{ settings.social_instagram }}" class="nt-footer__link" target="_blank">Instagram</a>
        {% endif %}
      </div>
    </div>
    <div class="nt-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} NANOTRONICS · El Carmen de Viboral, Antioquia</span>
      <span>{{ 'general.secure_payment' | t }} · {{ 'general.warranty' | t }} · {{ settings.store_hours }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "class": "section-footer",
  "settings": []
}
{% endschema %}
