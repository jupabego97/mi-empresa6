<section class="nt-container nt-cart">
  <div>
    <h1 class="nt-heading" style="font-size:1.75rem;margin-bottom:2rem">{{ 'general.cart_title' | t }}</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post">
        {% for item in cart.items %}
          <div class="nt-card" style="display:grid;grid-template-columns:100px 1fr auto;gap:1.25rem;padding:1.25rem;margin-bottom:1rem;align-items:center">
            <a href="{{ item.url }}">
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" width="100" height="100" style="object-fit:contain;background:var(--nt-gray-50);border-radius:8px;padding:0.5rem">
            </a>
            <div>
              <a href="{{ item.url }}" style="font-weight:700;font-size:0.9375rem">{{ item.product.title }}</a>
              {% unless item.variant.title == 'Default Title' %}
                <p style="font-size:0.8125rem;color:var(--nt-gray-500)">{{ item.variant.title }}</p>
              {% endunless %}
              <p style="font-weight:800;margin-top:0.5rem">{{ item.final_line_price | money }}</p>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.5rem">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:64px;padding:0.5rem;border:1px solid var(--nt-gray-200);border-radius:8px;text-align:center">
              <a href="{{ item.url_to_remove }}" style="font-size:0.75rem;color:var(--nt-danger)">{{ 'general.remove' | t }}</a>
            </div>
            <input type="hidden" name="id" value="{{ item.variant.id }}">
          </div>
        {% endfor %}
        <button type="submit" name="update" class="nt-btn nt-btn--secondary">{{ 'general.update_cart' | t }}</button>
      </form>

      <div style="margin-top:2.5rem">
        <h2 style="font-size:1.125rem;font-weight:800;margin-bottom:1rem">{{ 'general.upsell_title' | t }}</h2>
        <div class="nt-grid nt-grid--3">
          {% for product in collections.all.products limit: 3 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div style="text-align:center;padding:4rem 2rem">
        <p style="font-size:1.25rem;font-weight:700;margin-bottom:1rem">{{ 'general.empty_cart' | t }}</p>
        <a href="{{ routes.collections_url }}" class="nt-btn nt-btn--primary">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {% endif %}
  </div>

  {% if cart.item_count > 0 %}
    <aside class="nt-cart__summary">
      <h2 style="font-size:1.125rem;font-weight:800;margin-bottom:1.5rem">{{ 'general.summary' | t }}</h2>
      <div style="display:flex;justify-content:space-between;margin-bottom:0.75rem;font-size:0.9375rem">
        <span>{{ 'general.subtotal' | t }}</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <div style="display:flex;justify-content:space-between;margin-bottom:0.75rem;font-size:0.875rem;color:var(--nt-gray-500)">
        <span>{{ 'general.shipping' | t }}</span>
        <span>{{ 'general.shipping_at_checkout' | t }}</span>
      </div>
      {% if settings.show_installments %}
        <p style="font-size:0.8125rem;color:var(--nt-electric);margin-bottom:1.5rem">{{ settings.installments_text }}</p>
      {% endif %}
      <hr style="border:none;border-top:1px solid var(--nt-gray-200);margin:1rem 0">
      <div style="display:flex;justify-content:space-between;font-size:1.125rem;font-weight:800;margin-bottom:1.5rem">
        <span>{{ 'general.total' | t }}</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <a href="{{ routes.cart_url }}" class="nt-btn nt-btn--primary nt-btn--full nt-btn--lg">{{ 'general.checkout' | t }}</a>
      {% assign cart_wa = 'whatsapp.cart_message' | t %}
      {% render 'whatsapp-link', message: cart_wa, class: 'nt-btn--full', label: 'product.ask_whatsapp' | t %}
      <p style="font-size:0.75rem;color:var(--nt-gray-500);text-align:center;margin-top:1rem">{{ 'general.secure_footer' | t }}</p>
    </aside>
  {% endif %}
</section>

{% schema %}
{
  "name": "Carrito",
  "tag": "section",
  "class": "section-main-cart",
  "settings": []
}
{% endschema %}
