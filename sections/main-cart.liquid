<section class="nt-section nt-section--gray nt-cart-page">
  <div class="nt-container">
    <header class="nt-cart-page__header">
      <div>
        <h1 class="nt-cart-page__title">{{ 'general.cart_title' | t }}</h1>
        {% if cart.item_count > 0 %}
          <p class="nt-cart-page__count">
            {% if cart.item_count == 1 %}
              {{ 'general.cart_items_count_one' | t }}
            {% else %}
              {{ cart.item_count }} {{ 'general.products_count' | t }}
            {% endif %}
          </p>
        {% endif %}
      </div>
      <a href="{{ routes.collections_url }}" class="nt-btn nt-btn--secondary nt-btn--sm nt-cart-page__back">
        ← {{ 'general.continue_shopping' | t }}
      </a>
    </header>

    {% if cart.item_count > 0 %}
      <div class="nt-cart">
        <div class="nt-cart__main">
          <form action="{{ routes.cart_url }}" method="post" id="nt-cart-form" class="nt-cart__form">
            <div class="nt-cart__items">
              {% for item in cart.items %}
                {% render 'cart-line-item', item: item %}
              {% endfor %}
            </div>

            <div class="nt-cart__form-actions">
              <button type="submit" name="update" class="nt-btn nt-btn--secondary">
                {{ 'general.update_cart' | t }}
              </button>
            </div>
          </form>

          <div class="nt-cart__trust">
            <div class="nt-cart__trust-item">
              {% render 'icon', name: 'truck' %}
              <span>{{ 'general.free_shipping' | t }}</span>
            </div>
            <div class="nt-cart__trust-item">
              {% render 'icon', name: 'shield' %}
              <span>{{ 'general.warranty' | t }}</span>
            </div>
            <div class="nt-cart__trust-item">
              {% render 'icon', name: 'shield' %}
              <span>{{ 'general.secure_payment' | t }}</span>
            </div>
          </div>

          {% if section.settings.show_upsell %}
            <div class="nt-cart__upsell">
              <h2 class="nt-cart__upsell-title">{{ 'general.upsell_title' | t }}</h2>
              <div class="nt-grid nt-grid--3">
                {% assign upsell_collection = section.settings.upsell_collection %}
                {% if upsell_collection != blank %}
                  {% for product in upsell_collection.products limit: 3 %}
                    {% render 'product-card', product: product %}
                  {% endfor %}
                {% else %}
                  {% for product in collections.all.products limit: 3 %}
                    {% render 'product-card', product: product %}
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>

        <aside class="nt-cart__summary" aria-label="{{ 'general.summary' | t }}">
          <div class="nt-cart__summary-card">
            <h2 class="nt-cart__summary-title">{{ 'general.summary' | t }}</h2>

            <dl class="nt-cart__summary-rows">
              <div class="nt-cart__summary-row">
                <dt>{{ 'general.subtotal' | t }}</dt>
                <dd>{{ cart.total_price | money }}</dd>
              </div>
              <div class="nt-cart__summary-row nt-cart__summary-row--muted">
                <dt>{{ 'general.shipping' | t }}</dt>
                <dd>{{ 'general.shipping_at_checkout' | t }}</dd>
              </div>
            </dl>

            {% if settings.show_installments %}
              <p class="nt-cart__installments">{{ settings.installments_text }}</p>
            {% endif %}

            <div class="nt-cart__summary-total">
              <span>{{ 'general.total' | t }}</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>

            <div class="nt-cart__summary-actions">
              <button type="submit" form="nt-cart-form" name="checkout" class="nt-btn nt-btn--primary nt-btn--lg nt-btn--full">
                {{ 'general.checkout' | t }}
              </button>
              {% assign cart_wa = 'whatsapp.cart_message' | t %}
              {% render 'whatsapp-link', message: cart_wa, class: 'nt-btn--full' %}
            </div>

            <p class="nt-cart__summary-note">{{ 'general.secure_footer' | t }}</p>
          </div>
        </aside>
      </div>

      <div class="nt-cart__mobile-bar" aria-hidden="true">
        <div class="nt-cart__mobile-bar-inner">
          <div>
            <span class="nt-cart__mobile-label">{{ 'general.total' | t }}</span>
            <strong class="nt-cart__mobile-total">{{ cart.total_price | money }}</strong>
          </div>
          <button type="submit" form="nt-cart-form" name="checkout" class="nt-btn nt-btn--primary">
            {{ 'general.checkout' | t }}
          </button>
        </div>
      </div>
    {% else %}
      <div class="nt-cart-empty">
        <div class="nt-cart-empty__icon" aria-hidden="true">
          {% render 'icon', name: 'cart' %}
        </div>
        <h2 class="nt-cart-empty__title">{{ 'general.empty_cart' | t }}</h2>
        <p class="nt-cart-empty__text">{{ 'general.empty_cart_hint' | t }}</p>
        <div class="nt-cart-empty__actions">
          <a href="{{ routes.collections_url }}" class="nt-btn nt-btn--primary nt-btn--lg">{{ 'general.view_products' | t }}</a>
          {% render 'whatsapp-link', class: 'nt-btn--lg' %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Carrito",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_upsell",
      "label": "Mostrar productos sugeridos",
      "default": true
    },
    {
      "type": "collection",
      "id": "upsell_collection",
      "label": "Colección para sugerencias"
    }
  ]
}
{% endschema %}
