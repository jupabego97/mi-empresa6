<section class="nt-container nt-collection">
  <aside class="nt-filters" data-nt-filters aria-label="Filtros">
    <h2 style="font-size:1rem;font-weight:800;margin-bottom:1.5rem">Filtros</h2>

    <div class="nt-filter-group">
      <h3 class="nt-filter-group__title">Precio</h3>
      <form>
        <input type="number" placeholder="Mín" style="width:100%;padding:0.5rem;margin-bottom:0.5rem;border:1px solid var(--nt-gray-200);border-radius:8px">
        <input type="number" placeholder="Máx" style="width:100%;padding:0.5rem;border:1px solid var(--nt-gray-200);border-radius:8px">
      </form>
    </div>

    {% if collection.all_vendors.size > 0 %}
      <div class="nt-filter-group">
        <h3 class="nt-filter-group__title">Marca</h3>
        {% for vendor in collection.all_vendors %}
          <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.875rem;padding:0.25rem 0;cursor:pointer">
            <input type="checkbox"> {{ vendor }}
          </label>
        {% endfor %}
      </div>
    {% endif %}

    {% for filter in collection.filters %}
      <div class="nt-filter-group">
        <h3 class="nt-filter-group__title">{{ filter.label }}</h3>
        {% case filter.type %}
          {% when 'list' %}
            {% for value in filter.values %}
              <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.875rem;padding:0.25rem 0">
                <input type="checkbox" {% if value.active %}checked{% endif %}>
                {{ value.label }} ({{ value.count }})
              </label>
            {% endfor %}
        {% endcase %}
      </div>
    {% endfor %}
  </aside>

  <div>
    <header style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem">
      <div>
        <h1 class="nt-heading" style="font-size:1.75rem">{{ collection.title }}</h1>
        {% if collection.description != blank %}
          <p class="nt-subheading" style="margin-top:0.5rem">{{ collection.description }}</p>
        {% endif %}
        <p style="font-size:0.875rem;color:var(--nt-gray-500);margin-top:0.5rem">{{ collection.products_count }} productos</p>
      </div>
      <div style="display:flex;gap:0.75rem;align-items:center">
        <button type="button" class="nt-btn nt-btn--secondary nt-btn--sm" data-nt-filter-toggle>Filtros</button>
        <select style="padding:0.5rem 1rem;border:1px solid var(--nt-gray-200);border-radius:8px;font-size:0.875rem">
          <option>Destacados</option>
          <option>Precio: menor a mayor</option>
          <option>Precio: mayor a menor</option>
          <option>Más recientes</option>
        </select>
      </div>
    </header>

    {% paginate collection.products by 24 %}
      <div class="nt-grid nt-grid--4">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p style="grid-column:1/-1;text-align:center;padding:3rem;color:var(--nt-gray-500)">No hay productos en esta colección.</p>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}
        <nav style="display:flex;justify-content:center;gap:0.5rem;margin-top:2.5rem" aria-label="Paginación">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="nt-btn nt-btn--secondary nt-btn--sm">← Anterior</a>
          {% endif %}
          <span style="padding:0.5rem 1rem;font-size:0.875rem">Página {{ paginate.current_page }} de {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="nt-btn nt-btn--secondary nt-btn--sm">Siguiente →</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Colección",
  "tag": "section",
  "class": "section-main-collection",
  "settings": []
}
{% endschema %}
