<section class="nt-section nt-section--gray">
  <div class="nt-container">
    {% render 'breadcrumbs' %}

    <div class="nt-collection">
      <aside class="nt-filters" data-nt-filters aria-label="{{ 'accessibility.filters' | t }}">
        <div class="nt-filters__head">
          <h2 class="nt-filters__title">{{ 'general.filters' | t }}</h2>
          <button type="button" class="nt-filters__close" data-nt-filter-close aria-label="{{ 'accessibility.close' | t }}">×</button>
        </div>
        {% render 'collection-filters', collection: collection %}
      </aside>

      <div class="nt-collection__main">
        <header class="nt-collection__header">
          <div>
            <h1 class="nt-collection__title">{{ collection.title }}</h1>
            {% if collection.description != blank %}
              <p class="nt-collection__desc">{{ collection.description }}</p>
            {% endif %}
            <p class="nt-collection__count">{{ collection.products_count }} {{ 'general.products_count' | t }}</p>
          </div>
          <div class="nt-collection__toolbar">
            <button type="button" class="nt-btn nt-btn--secondary nt-btn--sm" data-nt-filter-toggle>{{ 'general.filters' | t }}</button>
            <form class="nt-collection__sort" method="get">
              {% for filter in collection.filters %}
                {% for value in filter.active_values %}
                  <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
                {% endfor %}
              {% endfor %}
              <label class="visually-hidden" for="SortBy">{{ 'collection.sort_label' | t }}</label>
              <select id="SortBy" name="sort_by" class="nt-collection__sort-select" data-nt-sort>
                <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>{{ 'collection.sort_featured' | t }}</option>
                <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>{{ 'collection.sort_best_selling' | t }}</option>
                <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>{{ 'collection.sort_title_asc' | t }}</option>
                <option value="title-descending" {% if collection.sort_by == 'title-descending' %}selected{% endif %}>{{ 'collection.sort_title_desc' | t }}</option>
                <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>{{ 'collection.sort_price_asc' | t }}</option>
                <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>{{ 'collection.sort_price_desc' | t }}</option>
                <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>{{ 'collection.sort_newest' | t }}</option>
              </select>
            </form>
          </div>
        </header>

        {% paginate collection.products by section.settings.products_per_page %}
          <div class="nt-grid nt-grid--4">
            {% for product in collection.products %}
              {% render 'product-card', product: product %}
            {% else %}
              <p class="nt-collection__empty">{{ 'general.no_products' | t }}</p>
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <nav class="nt-pagination" aria-label="{{ 'accessibility.pagination' | t }}">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="nt-btn nt-btn--secondary nt-btn--sm">← {{ 'general.previous' | t }}</a>
              {% endif %}
              <span class="nt-pagination__info">{{ 'general.page_of' | t }} {{ paginate.current_page }} {{ 'general.of' | t }} {{ paginate.pages }}</span>
              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="nt-btn nt-btn--secondary nt-btn--sm">{{ 'general.next' | t }} →</a>
              {% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colección",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 12,
      "default": 24,
      "label": "Productos por página"
    }
  ]
}
{% endschema %}
