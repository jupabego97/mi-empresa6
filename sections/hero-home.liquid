<section class="nt-hero" aria-label="{{ 'accessibility.hero' | t }}">
  <div class="nt-container nt-hero__grid">
    <div>
      <p class="nt-hero__eyebrow">{% render 'i18n-or-setting', value: section.settings.eyebrow, locale_key: 'home.hero_eyebrow' %}</p>
      <h1 class="nt-hero__title">{% render 'i18n-or-setting', value: section.settings.headline, locale_key: 'home.hero_headline' %}</h1>
      <p class="nt-hero__subtitle">{% render 'i18n-or-setting', value: section.settings.subheadline, locale_key: 'home.hero_subheadline' %}</p>
      <div class="nt-hero__ctas">
        <a href="{{ section.settings.cta_primary_url | default: routes.collections_url }}" class="nt-btn nt-btn--primary nt-btn--lg">
          {% render 'i18n-or-setting', value: section.settings.cta_primary_label, locale_key: 'general.view_products' %}
        </a>
        {% assign wa_label = section.settings.cta_whatsapp_label %}
        {% render 'whatsapp-link', class: 'nt-btn--lg', label: wa_label %}
      </div>
    </div>
    <div class="nt-hero__visual">
      {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | default: 'Setup gamer premium NANOTRONICS' }}"
          width="1200"
          height="900"
          loading="eager"
          fetchpriority="high"
        >
      {% else %}
        <img src="https://images.unsplash.com/photo-1593305841991-05caca21f9fe?w=1200&q=80&auto=format&fit=crop" alt="Setup gamer moderno" width="1200" height="900" loading="eager" fetchpriority="high">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero inicio",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "NANOTRONICS · Viboral, Antioquia" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Tecnología que impulsa tu rendimiento" },
    { "type": "textarea", "id": "subheadline", "label": "Subtítulo", "default": "Portátiles, celulares, audio, gaming, accesorios, servicio técnico y mucho más." },
    { "type": "image_picker", "id": "image", "label": "Imagen hero (setup gamer)" },
    { "type": "url", "id": "cta_primary_url", "label": "URL botón principal" },
    { "type": "text", "id": "cta_primary_label", "label": "Texto botón principal", "default": "Ver productos" },
    { "type": "text", "id": "cta_whatsapp_label", "label": "Texto WhatsApp", "default": "Hablar por WhatsApp" }
  ],
  "presets": [{ "name": "Hero inicio" }]
}
{% endschema %}
