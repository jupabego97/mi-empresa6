{% doc %}
Menú lateral móvil con navegación principal.
{% enddoc %}
<div class="nt-mobile-menu" data-nt-mobile-nav aria-hidden="true">
  <div class="nt-mobile-menu__backdrop" data-nt-menu-close></div>
  <div class="nt-mobile-menu__panel" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.menu' | t }}">
    <div class="nt-mobile-menu__head">
      <span class="nt-header__logo">NANO<span>TRONICS</span></span>
      <button type="button" class="nt-mobile-menu__close" data-nt-menu-close aria-label="{{ 'accessibility.close' | t }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <form action="{{ routes.search_url }}" method="get" class="nt-mobile-menu__search">
      <div class="nt-search">
        <input type="search" name="q" placeholder="{{ 'general.search' | t }}" aria-label="{{ 'general.search' | t }}">
        <button type="submit">{{ 'general.search_submit' | t }}</button>
      </div>
    </form>
    <nav class="nt-mobile-menu__nav">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      <a href="{{ routes.collections_url }}">{{ 'general.categories' | t }}</a>
      <a href="{{ routes.collections_url }}/ofertas" class="nt-mobile-menu__highlight">{{ 'general.offers' | t }}</a>
      <a href="/pages/marcas">{{ 'general.brands' | t }}</a>
      <a href="/pages/servicio-tecnico">{{ 'general.technical_service' | t }}</a>
      <a href="/pages/nosotros">{{ 'footer.about' | t }}</a>
      <a href="/pages/contacto">{{ 'footer.contact' | t }}</a>
      {% assign mobile_menu = linklists['main-menu'] %}
      {% for link in mobile_menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>
    <div class="nt-mobile-menu__actions">
      {% render 'whatsapp-link', class: 'nt-btn--full' %}
      <a href="{{ routes.account_url }}" class="nt-btn nt-btn--secondary nt-btn--full">{{ 'general.login' | t }}</a>
    </div>
  </div>
</div>
