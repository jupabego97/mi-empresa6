{% doc %}
@param {line_item} item - Línea del carrito Shopify
{% enddoc %}
<div class="nt-cart-item">
  <a href="{{ item.url }}" class="nt-cart-item__media">
    {% if item.image %}
      <img
        src="{{ item.image | image_url: width: 240 }}"
        alt="{{ item.image.alt | default: item.product.title | escape }}"
        width="120"
        height="120"
        loading="lazy"
      >
    {% else %}
      <div class="nt-cart-item__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
    {% endif %}
  </a>

  <div class="nt-cart-item__body">
    <div class="nt-cart-item__header">
      <div>
        {% if item.product.vendor != blank %}
          <p class="nt-cart-item__vendor">{{ item.product.vendor }}</p>
        {% endif %}
        <a href="{{ item.url }}" class="nt-cart-item__title">{{ item.product.title }}</a>
        {% unless item.variant.title == 'Default Title' %}
          <p class="nt-cart-item__variant">{{ item.variant.title }}</p>
        {% endunless %}
      </div>
      <a href="{{ item.url_to_remove }}" class="nt-cart-item__remove" aria-label="{{ 'general.remove' | t }}: {{ item.product.title }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </a>
    </div>

    <div class="nt-cart-item__footer">
      <div class="nt-cart-item__qty" data-nt-qty>
        <button type="button" class="nt-cart-item__qty-btn" data-nt-qty-minus aria-label="{{ 'general.decrease_qty' | t }}">−</button>
        <input
          type="number"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          class="nt-cart-item__qty-input"
          aria-label="{{ 'general.quantity' | t }}"
          data-nt-qty-input
        >
        <button type="button" class="nt-cart-item__qty-btn" data-nt-qty-plus aria-label="{{ 'general.increase_qty' | t }}">+</button>
      </div>
      <div class="nt-cart-item__pricing">
        {% if item.original_line_price != item.final_line_price %}
          <span class="nt-cart-item__compare">{{ item.original_line_price | money }}</span>
        {% endif %}
        <span class="nt-cart-item__price">{{ item.final_line_price | money }}</span>
        <span class="nt-cart-item__unit">{{ item.final_price | money }} / ud.</span>
      </div>
    </div>
  </div>
</div>
